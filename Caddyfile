# Caddy reverse proxy for SistemaConnect
#
# La dirección del sitio sale de SITE_ADDRESS (en el .env del server):
#
#   SITE_ADDRESS=:80                  IP cruda, sin TLS (default).
#   SITE_ADDRESS=admin.midominio.ar   dominio real: Caddy emite el certificado
#                                     solo, publicando los puertos 80 y 443
#                                     (PROXY_HTTP_PORT=80, PROXY_HTTPS_PORT=443).

{
	admin off
}

{$SITE_ADDRESS::80} {
	encode zstd gzip

	# API del backend (Flask + Gunicorn).
	handle /api/* {
		reverse_proxy backend:5001
	}

	# SPA del frontend (nginx).
	handle {
		reverse_proxy frontend:80
	}

	log {
		output stdout
		format console
	}
}
