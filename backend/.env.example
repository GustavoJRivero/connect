FLASK_ENV=development
FLASK_DEBUG=1

# Security
SECRET_KEY=change-me
JWT_SECRET_KEY=change-me-too
# Duración del access token JWT (minutos). Si no se setea, default = 60.
JWT_ACCESS_TOKEN_MINUTES=60

# Zona horaria de la aplicación (IANA). Default: America/Argentina/Buenos_Aires.
# Afecta la lógica de "hoy" (facturación, vencimientos) y la serialización ISO al frontend.
APP_TIMEZONE=America/Argentina/Buenos_Aires

# Database (MySQL). Crear la base "sistemaconnect" antes de correr migraciones.
# Ejemplo: mysql -u root -p -e "CREATE DATABASE IF NOT EXISTS sistemaconnect;"
DATABASE_URL=mysql+pymysql://root:root@127.0.0.1:3306/sistemaconnect

# AFIP (WSFE)
AFIP_ENV=HOMOLOGACION  # or PRODUCCION
AFIP_CUIT=20123456789
AFIP_CERT_PATH=./secrets/afip/cert.crt
AFIP_KEY_PATH=./secrets/afip/private.key

# Mikrotik (RouterOS API)
MIKROTIK_HOST=10.0.0.1
MIKROTIK_PORT=8728
MIKROTIK_USER=apiuser
MIKROTIK_PASS=apipass
# Staging: bloquear cortes, altas/bajas PPPoE y sync de perfiles hacia Mikrotik.
# MIKROTIK_WRITES_DISABLED=true
# IPs/hostnames del Mikrotik de producción (coma-separados) para avisos en Migración.
# MIKROTIK_PROD_HOSTS=10.0.0.1

# Connect Maps API (disponibilidad / cálculo de instalación / reserva de puertos NAP)
# Key Read/Write (cmk_write_...) — la reserva/liberación de puertos escribe el infoTable del NAP.
MAPS_API_BASE_URL=https://maps.connectsrl.ar
MAPS_API_KEY=
# Secret compartido que debe mandar la app de mapas en el header X-Webhook-Secret
# al confirmar instalaciones (POST /api/webhooks/maps/install-confirmed).
MAPS_WEBHOOK_SECRET=

# Portal de cliente + Mercado Pago
# Access token y public key de la aplicación (producción o prueba).
MP_ACCESS_TOKEN=
MP_PUBLIC_KEY=
# URL pública del webhook (ngrok / dominio). Si está vacío usa API_PUBLIC_URL/api/webhooks/mercadopago
MP_WEBHOOK_URL=
API_PUBLIC_URL=http://localhost:5001
# URL del frontend (back_urls de Checkout Pro)
PORTAL_PUBLIC_URL=http://localhost
