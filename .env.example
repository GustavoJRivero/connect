# ============================================================
# Docker Compose - Variables de entorno
# Copiar este archivo como .env y ajustar los valores.
#   cp .env.example .env
# ============================================================

# --- MySQL ---
MYSQL_ROOT_PASSWORD=root
MYSQL_USER=root

# --- Backend (Flask) ---
FLASK_ENV=production
SECRET_KEY=genera-una-clave-segura-aqui
JWT_SECRET_KEY=genera-otra-clave-segura-aqui
# Orígenes web autorizados, separados por coma. Solo hace falta si el frontend
# está en otro dominio que la API. Vacío = sin origen cruzado. Nunca usar "*".
CORS_ORIGINS=
# Google reCAPTCHA v3. Opcional: se puede cargar desde Configuración → Seguridad
# en el panel; esto queda como respaldo. Sin claves, el captcha no se exige.
RECAPTCHA_SITE_KEY=
RECAPTCHA_SECRET_KEY=
RECAPTCHA_MIN_SCORE=0.5
# Cadena aleatoria que se pide una sola vez, al crear el primer administrador.
# Si ya existe un admin, dejalo vacío: el endpoint queda deshabilitado.
BOOTSTRAP_TOKEN=
# Firma secreta de Webhooks de Mercado Pago. Opcional: se puede cargar desde
# Configuración → Mercado Pago en el panel; este valor queda como respaldo.
MP_WEBHOOK_SECRET=

# --- AFIP (opcional, dejar vacío si no se usa) ---
AFIP_ENV=HOMOLOGACION
AFIP_CUIT=
AFIP_CERT_PATH=
AFIP_KEY_PATH=

# --- Mikrotik (opcional, dejar vacío si no se usa) ---
MIKROTIK_HOST=
MIKROTIK_PORT=8728
MIKROTIK_USER=
MIKROTIK_PASS=

# --- Proxy (solo producción) ---
# Dirección que atiende Caddy. ":80" = por IP, sin TLS.
# Con un dominio real, poner el dominio y publicar los puertos 80 y 443:
#   SITE_ADDRESS=admin.midominio.ar
#   PROXY_HTTP_PORT=80
#   PROXY_HTTPS_PORT=443
SITE_ADDRESS=:80
PROXY_HTTP_PORT=8088
PROXY_HTTPS_PORT=44333

# --- Frontend ---
# URL pública del backend. Dejar vacío cuando el panel y la API se sirven bajo
# el mismo dominio (el caso normal con el proxy): el navegador usa el mismo origen.
REACT_APP_API_BASE_URL=
